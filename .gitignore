# Ignore Python virtual environments
.jlenv/
.judais-lobi-venv/
.venv/

# Ignore editor settings and caches
.idea/
.vscode/
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Ignore test/output artifacts
speech.wav
*.log

# Ignore local dev configs or checkpoints
.cadence/
.lobienv/
.judaisenv/

# Runtime worktree directory
.judais-lobi/worktrees/

# Byte-compiled and temporary files
.DS_Store
.judais-lobi/

# A private handoff note between agents working this checkout. Untracked on
# purpose: it is working correspondence, not a document the repository keeps.
CLAUDE.local.md

# Copies made before a risky edit, which exist on the deployment and have no
# business travelling back. A `core.bak-*/` is a second copy of the package
# on `sys.path`, and the stale one wins as often as not.
*.bak-*
*.bak-prehistory
core.bak-*/
